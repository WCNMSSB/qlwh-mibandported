            {line: 53926, label: 'CHAPTER8-1'},
            {line: 54910, label: 'CHAPTER8-2'}
        ]
    },
    async loadStart(a) {
    try {
        await new Promise((resolve, reject) => {
            storage.set({
                key: 'readProgress',
                value: a.toString(),          // 直接用字符串即可
                success: resolve,
                fail: reject
            });
        });
        console.log('进度设置成功');
        router.push({ uri: 'pages/detail' });
    } catch (error) {
        console.error('进度设置失败:', error);
        // 可考虑提示用户或依然跳转（但此时进度可能未保存）
        // router.push({ uri: 'pages/detail' }); // 不推荐
    }
    },
    back(){ 
        router.back({
            uri:'pages/more',
        }) 
    }, 
    last() { 
        if (this.page > 1) {
            this.page -= 1;
        } else {
            this.page = 7;
        }
    },
    enter() { 
        if (this.page < 7) {
            this.page += 1;
        } else {
            this.page = 1;
        }
    },
}; 
